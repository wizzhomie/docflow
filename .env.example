# DocFlow configuration. Copy to .env and fill in what you need; everything is optional.
# .env itself is git-ignored, never commit real credentials.

# Bind address of the local service (dev.sh uses HOST/PORT; uvicorn defaults below).
HOST=0.0.0.0
PORT=8765

# Demo mode: 1 = Confirm returns a simulated deal and never calls the CRM.
DOCFLOW_DEMO_MODE=1

# Active CRM: uspacy | bitrix24 | none
DOCFLOW_CRM=uspacy

# Uspacy account (used when DOCFLOW_CRM=uspacy).
USPACY_BASE_URL=https://aitesting.uspacy.com
USPACY_EMAIL=
USPACY_PASSWORD=

# Bitrix24 incoming webhook (used when DOCFLOW_CRM=bitrix24):
# https://<portal>/rest/1/<token>/
BITRIX24_WEBHOOK_URL=

# Amount above which a confirmed document goes to Approval instead of Payments.
DOCFLOW_APPROVAL_THRESHOLD=100000

# Manual-entry minutes per document for the impact report.
DOCFLOW_MANUAL_MINUTES=3

# Mailbox intake (IMAP). Empty host/user/password disables it: documents then come
# only from uploads and the data/inbox/ folder.
# Gmail: IMAP must be enabled; access needs an app password (2-Step Verification).
DOCFLOW_IMAP_HOST=
DOCFLOW_IMAP_PORT=993
DOCFLOW_IMAP_USER=
DOCFLOW_IMAP_PASSWORD=
DOCFLOW_IMAP_FOLDER=INBOX
DOCFLOW_IMAP_INTERVAL=30
DOCFLOW_IMAP_SSL=1

# Portable Tesseract for OCR without root (see docs/stack-and-operations.md).
# export PATH="/home/user/projects/docflow/.tools/ocr/bin:$PATH"

# OCR languages. Empty means the union of the registered document profiles
# (ukr+eng for the Ukrainian invoice and act). Set it explicitly for a market
# whose profile is not registered yet, e.g. DOCFLOW_OCR_LANGS=eng+deu.
DOCFLOW_OCR_LANGS=

# External dead-man switch (Healthchecks.io or compatible). Empty disables the ping;
# the healthcheck log stays the record. Example:
# https://hc-ping.com/00000000-0000-0000-0000-000000000000
DOCFLOW_PING_URL=

# The optional meaning layer: a model points at the line a value is printed on,
# the code copies it and records the provenance. `off` runs the deterministic
# pipeline; `shadow` records what the model would have said without changing an
# answer; `on` applies a pointer when its text is really present. The key is not
# kept in the repository: the unit reads it from the operator's private file
# (~/.config/docflow/models.env), or from the environment.
DOCFLOW_MEANING=off
DOCFLOW_MEANING_URL=https://api.groq.com/openai/v1/chat/completions
DOCFLOW_MEANING_MODEL=qwen/qwen3.8-27b
DOCFLOW_MEANING_KEY=

# Extraction cost limits: how many documents are read at once, how long a request
# waits for a slot, how many pages of a scan reach OCR and for how long.
DOCFLOW_MAX_EXTRACTIONS=2
DOCFLOW_EXTRACTION_WAIT=10
DOCFLOW_MAX_OCR_PAGES=10
DOCFLOW_MAX_OCR_SECONDS=180
