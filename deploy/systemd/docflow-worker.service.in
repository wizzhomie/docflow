[Unit]
Description=DocFlow background worker (durable queue)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DOCFLOW_ROOT__
EnvironmentFile=-__DOCFLOW_ROOT__/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__DOCFLOW_ROOT__/.venv/bin/python -m worker
Restart=always
RestartSec=5

# Least privilege: read-only system, private /tmp, no new privileges, writes only its
# own data. The units run as an ordinary user, so there are no capabilities to keep.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Environment=PYTHONDONTWRITEBYTECODE=1
ReadWritePaths=__DOCFLOW_ROOT__/data __DOCFLOW_ROOT__/.run

[Install]
WantedBy=multi-user.target
