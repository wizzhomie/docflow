[Unit]
Description=DocFlow off-site copy (restic to Backblaze B2)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
Environment=DOCFLOW_BACKUP_ENV=__USER_HOME__/.config/docflow/backup.env
Environment=DOCFLOW_BACKUP_DIR=__USER_HOME__/backups/docflow
ExecStart=__DEPLOY_ROOT__/backup/offsite.sh
