[Unit]
Description=DocFlow demo (document intake prototype, demo mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DOCFLOW_ROOT__
EnvironmentFile=-__DOCFLOW_ROOT__/.env
# The queue has its own unit (`docflow-worker`), so the web process does not
# start a second in-process worker: one place claims a job, one log shows it.
Environment=DOCFLOW_JOBS=off
ExecStart=__DOCFLOW_ROOT__/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3

# Least privilege: read-only system, private /tmp, no new privileges, writes only its
# own data. The units run as an ordinary user, so there are no capabilities to keep.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Environment=PYTHONDONTWRITEBYTECODE=1
ReadWritePaths=__DOCFLOW_ROOT__/data __DOCFLOW_ROOT__/.run

[Install]
WantedBy=multi-user.target
