[Unit]
Description=DocFlow assistant API (chat, widget, grounding)
After=network-online.target docflow.service docflow-operator-model.service
Wants=docflow.service docflow-operator-model.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ASSISTANT_ROOT__
Environment=DOCFLOW_URL=http://127.0.0.1:8765
Environment=OPERATOR_MODEL_URL=http://127.0.0.1:8080
Environment=OPERATOR_PORT=8769
# The DocFlow demo embeds this widget from its chat subdomain, so the demo page
# (and its www alias) are the allowed origins.
Environment=OPERATOR_CORS_ORIGINS=__CORS_ORIGINS__
Environment=OPERATOR_DEMO_URL=__DEMO_URL__
ExecStart=__ASSISTANT_ROOT__/.venv/bin/python -m uvicorn docflow_operator.server:app --host 0.0.0.0 --port 8769
Restart=always
RestartSec=3
StandardOutput=append:__ASSISTANT_ROOT__/.run/logs/operator.log
StandardError=append:__ASSISTANT_ROOT__/.run/logs/operator.log

# Least privilege: read-only system, private /tmp, no new privileges, writes only its
# own data. The units run as an ordinary user, so there are no capabilities to keep.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Environment=PYTHONDONTWRITEBYTECODE=1
ReadWritePaths=__ASSISTANT_ROOT__/data __ASSISTANT_ROOT__/.run

[Install]
WantedBy=multi-user.target
